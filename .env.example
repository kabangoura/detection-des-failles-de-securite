# Copier ce fichier en « .env » puis renseigner la clé. Ne jamais remettre ni publier le fichier .env.
# Assistant IA (optionnel) : utilisé seulement par « plan-ia ».
# Clé Groq (plan gratuit) : https://console.groq.com/keys
GROQ_API_KEY=
# Ou clé xAI Grok : https://console.x.ai
# XAI_API_KEY=
# Forcer un fournisseur (groq ou xai) ou un modèle (optionnel)
# KMB_IA=groq
# KMB_IA_MODELE=openai/gpt-oss-120b
# Dossier des données lu par l'API (optionnel, défaut : ./data)
# KMB_DATA_DIR=data
