# Copier ce fichier en « .env » puis renseigner la clé. Ne jamais remettre le fichier .env.
# Clé de l'API Grok (xAI) : https://console.x.ai  -> utilisée seulement pour le « plan IA » (optionnel)
XAI_API_KEY=
# Modèle Grok (optionnel, défaut : grok-4.7)
XAI_MODEL=grok-4.7
# Dossier des données lu par l'API (optionnel, défaut : ./data)
# KMB_DATA_DIR=data
